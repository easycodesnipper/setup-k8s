# Generated by Ansible for {{ mirror_item.key }}
server = "https://{{ mirror_item.key }}"

{% for mirror in mirror_item.value %}
# Priority {{ loop.index }}: {{ 'Harbor Proxy' if 'harbor' in mirror else 'Public Mirror' }}
[host."{{ mirror }}"]
  capabilities = ["pull", "resolve"]
  skip_verify = {{ 'true' if (containerd_registry_mirror_skip_verify | default(true)) else 'false' }}

{% endfor %}
