---
# roles/initialize/template/kubeadm-config.yaml.j2

# kubeadm InitConfiguration generated by kubeadm config print init-defaults
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
bootstrapTokens:
  - groups:
      - system:bootstrappers:kubeadm:default-node-token
    token: {{ k8s_bootstrap_token | default('abcdef.0123456789abcdef') }}
    ttl: {{ k8s_bootstrap_token_ttl | default('24h0m0s') }}
    usages:
      - signing
      - authentication
localAPIEndpoint:
  # Fix: Use ansible_facts to clear deprecation warning
  advertiseAddress: {{ k8s_advertise_address | default(ansible_facts['default_ipv4']['address'] | default('0.0.0.0')) }}
  bindPort: {{ k8s_api_bind_port | default(6443) }}
nodeRegistration:
  criSocket: {{ k8s_cri_socket | default('unix:///var/run/containerd/containerd.sock') }}
  imagePullPolicy: {{ k8s_image_pull_policy | default('IfNotPresent') }}
  imagePullSerial: {{ (k8s_image_pull_serial | default(true)) | to_yaml }}
  # Fix: Use ansible_facts for hostname
  name: {{ k8s_node_name | default(ansible_facts['hostname'] | default('node')) }}
  taints: 
    - key: node-role.kubernetes.io/control-plane
      effect: NoSchedule
  # Fix: v1beta4 requires list of name/value objects, not a map
  kubeletExtraArgs: 
{% if k8s_kubelet_extra_args is defined and k8s_kubelet_extra_args is mapping %}
{% for key, value in k8s_kubelet_extra_args.items() %}
    - name: "{{ key }}"
      value: "{{ value }}"
{% endfor %}
{% else %}
    {{ k8s_kubelet_extra_args | default([]) | to_yaml }}
{% endif %}
uploadCerts: {{ (k8s_upload_certs | default(true)) | to_yaml }}
ignorePreflightErrors:
{{ k8s_ignore_preflight_errors | default(['Mem', 'NumCPU']) | to_nice_yaml(indent=2) | indent(2, first=True) }}
timeouts:
  controlPlaneComponentHealthCheck: {{ k8s_timeout_controlplane_health | default('4m0s') }}
  discovery: {{ k8s_timeout_discovery | default('5m0s') }}
  etcdAPICall: {{ k8s_timeout_etcd_api | default('2m0s') }}
  kubeletHealthCheck: {{ k8s_timeout_kubelet_health | default('4m0s') }}
  kubernetesAPICall: {{ k8s_timeout_kubeapi | default('1m0s') }}
  tlsBootstrap: {{ k8s_timeout_tls_bootstrap | default('5m0s') }}
  upgradeManifests: {{ k8s_timeout_upgrade_manifests | default('5m0s') }}
  
---
# ClusterConfiguration
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
apiServer: {}
controllerManager: {}
certificatesDir: {{ k8s_certificates_dir | default('/etc/kubernetes/pki') }}
clusterName: {{ k8s_cluster_name | default('kubernetes') }}
encryptionAlgorithm: {{ k8s_encryption_algorithm | default('RSA-2048') }}
caCertificateValidityPeriod: {{ k8s_ca_validity | default('87600h0m0s') }}
certificateValidityPeriod: {{ k8s_cert_validity | default('8760h0m0s') }}
etcd:
  local:
    dataDir: {{ k8s_etcd_data_dir | default('/var/lib/etcd') }}
dns:
  imageRepository: {{ k8s_image_repository | default('registry.k8s.io') }}/coredns
imageRepository: {{ k8s_image_repository | default('registry.k8s.io') }}
kubernetesVersion: {{ k8s_version | default('1.34.2') }}
networking:
  dnsDomain: {{ k8s_dns_domain | default('cluster.local') }}
  podSubnet: {{ k8s_pod_subnet | default('10.244.0.0/16') }}
  serviceSubnet: {{ k8s_service_subnet | default('10.96.0.0/12') }}
proxy: {}
scheduler: {}
