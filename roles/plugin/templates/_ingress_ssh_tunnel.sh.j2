#!/bin/bash
# Tunnel for K8s LoadBalancer IPs
# Generated by Ansible

# Using standard ports (80/443) requires the service to run as root.
# Identity file path is explicitly set to ensure root uses the correct user key.

exec /usr/bin/ssh -N \
  -i /home/{{ ssh_user }}/.ssh/{{ ssh_user_key }} \
{% for ip in lb_ips %}
{% if loop.first %}
  -L 0.0.0.0:80:{{ ip }}:80 \
  -L 0.0.0.0:443:{{ ip }}:443 \
  -L 0.0.0.0:18222:{{ ip }}:22 \
{% else %}
  -L 0.0.0.0:{{ 18080 + loop.index0 }}:{{ ip }}:80 \
  -L 0.0.0.0:{{ 18443 + loop.index0 }}:{{ ip }}:443 \
  -L 0.0.0.0:18222:{{ ip }}:22 \
{% endif %}
{% endfor %}
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=60 \
  -o ServerAliveCountMax=3 \
  {{ ansible_user }}@{{ ansible_host }}
