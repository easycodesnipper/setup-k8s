---
# roles/devops/templates/ca-server-manifest.yaml.j2

{# ansible localhost -m template -a "src=roles/plugin/templates/ca-server-manifest.yaml.j2 dest=/tmp/ca-server.yaml" #}

# Deployment: Runs a lightweight Nginx to serve the rootCA.pem file
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ca-server
  namespace: {{ k8s_plugin_ca_namespace | default('ca-system') }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: ca-server
  template:
    metadata:
      labels:
        app: ca-server
    spec:
      containers:
      - name: nginx
        image: nginx:alpine
        ports:
        - containerPort: 80
        volumeMounts:
        - name: ca-vol
          # Mount the specific CA file into Nginx's default HTML directory
          mountPath: /usr/share/nginx/html/rootCA.pem
          subPath: rootCA.pem
        - name: ca-vol
          # Mount the generated index.html for downloading
          mountPath: /usr/share/nginx/html/index.html
          subPath: index.html
      volumes:
      - name: ca-vol
        configMap:
          name: ca-dist-config
---
# Service: Internal ClusterIP for ca-server
apiVersion: v1
kind: Service
metadata:
  name: ca-server
  namespace: {{ k8s_plugin_ca_namespace | default('ca-system') }}
spec:
  type: ClusterIP
  ports:
    - port: 80
      targetPort: 80
  selector:
    app: ca-server
---
# Ingress: Expose ca-server via Traefik (HTTP only)
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ca-server
  namespace: {{ k8s_plugin_ca_namespace | default('ca-system') }}
  annotations:
    # Optional: force HTTP only (disable automatic HTTPS redirect if enabled globally)
    traefik.ingress.kubernetes.io/redirect-entry-point: ""
spec:
  ingressClassName: {{ k8s_plugin_ca_ingress_class | default('traefik') }} 
  rules:
    - host: {{ k8s_plugin_ca_host | default('ca.localdomain') }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: ca-server
                port:
                  number: 80
