---
# roles/devops/templates/devops-gitlab-values.yaml.j2

{# ansible localhost -m template -a "src=roles/plugin/templates/devops-gitlab-helm-values.yaml.j2 dest=/tmp/devops-gitlab-values.yaml" #}

{%- set tls_enabled = k8s_plugin_gitlab_global_ingress_tls_enabled | default(true) | bool %}

upgradeCheck:
  enabled: {{ k8s_plugin_gitlab_upgrade_check_enabled | default(false) }}

installCertmanager: {{ k8s_plugin_gitlab_install_certmanager | default(false) }}

global:
  edition: {{ k8s_plugin_gitlab_global_edition | default('ce') }}
{% if k8s_plugin_gitlab_global_external_url is defined %}
  external_url: {{ k8s_plugin_gitlab_global_external_url }}
{% else %}
  external_url: "{{ 'https' if tls_enabled else 'http' }}://gitlab.{{ k8s_host_domain | default('localdomain') }}"
{% endif %}
  hosts:
    domain: {{ k8s_host_domain | default('localdomain') }}
    https: {{ tls_enabled }}
  ingress:
    enabled: {{ k8s_plugin_gitlab_global_ingress_enabled | default(true) }}
    configureCertmanager: {{ k8s_plugin_gitlab_global_ingress_configure_certmanager | default(false) }}
    provider: {{ k8s_plugin_gitlab_global_ingress_provider | default('traefik') }}
    class: {{ k8s_plugin_gitlab_global_ingress_class | default('traefik') }}
    annotations:
      # 1. Always include websecure if TLS is on
      traefik.ingress.kubernetes.io/router.entrypoints: "{{ 'web, websecure' if tls_enabled else 'web' }}"
{% if tls_enabled %}
      # 2. Only apply the redirect middleware if TLS is actually enabled
      traefik.ingress.kubernetes.io/router.middlewares: "{{ k8s_plugin_traefik_namespace | default('traefik-system') }}-{{ k8s_plugin_traefik_middleware | default('redirect-https') }}@kubernetescrd"
    tls:
      secretName: {{ k8s_plugin_gitlab_ingress_tls_secret_name | default('mkcert-wildcard-tls') }}
{% endif %}

  # Parameterized SMTP configuration
  smtp:
    enabled: {{ k8s_plugin_gitlab_smtp_enabled | default(true) }}
    address: "{{ k8s_plugin_gitlab_smtp_address | default('smtp.qiye.aliyun.com') }}"
    port: {{ k8s_plugin_gitlab_smtp_port | default(465) }}
    user_name: "{{ k8s_plugin_gitlab_smtp_user_name | default('cdeyin@sbkswyy.cn') }}"
    password:
      secret: "{{ k8s_plugin_gitlab_smtp_password_secret_name | default('gitlab-smtp-password') }}"
      key: "{{ k8s_plugin_gitlab_smtp_password_key | default('password') }}"
    domain: "{{ k8s_plugin_gitlab_smtp_domain | default('smtp.qiye.aliyun.com') }}"
    authentication: "{{ k8s_plugin_gitlab_smtp_authentication | default('login') }}"
    starttls_auto: {{ k8s_plugin_gitlab_smtp_starttls_auto | default(false) }}
    tls: {{ k8s_plugin_gitlab_smtp_tls | default(true) }}
  
  # Parameterized Email headers
  email:
    from: "{{ k8s_plugin_gitlab_email_from | default(k8s_plugin_gitlab_smtp_user_name | default('cdeyin@sbkswyy.cn')) }}"
    display_name: "{{ k8s_plugin_gitlab_email_display_name | default('[GitLab]') }}"
    reply_to: "{{ k8s_plugin_gitlab_email_reply_to | default(k8s_plugin_gitlab_smtp_user_name | default('cdeyin@sbkswyy.cn')) }}"
    subject_suffix: "{{ k8s_plugin_gitlab_email_subject_suffix | default('') }}"

postgresql:
  enabled: {{ k8s_plugin_gitlab_postgresql_enabled | default(true) }}
  persistence:
    enabled: true
    storageClass: {{ k8s_plugin_gitlab_postgresql_storage_class | default('longhorn') }}
    size: {{ k8s_plugin_gitlab_postgresql_size | default('10Gi') }}

redis:
  install: true
  master:
    persistence:
      enabled: true
      storageClass: {{ k8s_plugin_gitlab_redis_storage_class | default('longhorn') }}
      size: {{ k8s_plugin_gitlab_redis_size | default('5Gi') }}

gitlab:
  webservice:
    workhorse:
      trusted_ips: {{ k8s_plugin_gitlab_webservice_workhorse_trusted_ips | default(['0.0.0.0/0']) | to_json }}
  sidekiq:
    replicas: {{ k8s_plugin_gitlab_sidekiq_replicas | default(1) }}
  gitaly:
    persistence:
      enabled: true
      storageClass: {{ k8s_plugin_gitlab_gitaly_storage_class | default('longhorn') }}
      size: {{ k8s_plugin_gitlab_gitaly_size | default('50Gi') }}

gitlab-shell:
  traefik:
    entrypoint: {{ k8s_plugin_traefik_ports_gitlab_shell | default('gitlab-shell') }}

registry:
  enabled: {{ k8s_plugin_gitlab_registry_enabled | default(false) | bool }}

nginx-ingress:
  enabled: {{ k8s_plugin_gitlab_nginx_ingress_enabled | default(false) | bool }}

traefik:
  install: {{ k8s_plugin_gitlab_traefik_install | default(false) | bool  }} # using external traefik

prometheus:
  install: {{ k8s_plugin_gitlab_prometheus_install | default(false) | bool  }}

gitlab-runner:
  install: false # Independent install as plugin
