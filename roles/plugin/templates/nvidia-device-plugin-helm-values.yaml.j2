# roles/plugin/templates/nvidia-device-plugin-helm-values.yaml.j2
---
# Plugin configuration via inline ConfigMap
config:
  default: "default"
  map:
    default: |-
      version: v1
      flags:
        migStrategy: "{{ k8s_plugin_nvidia_device_plugin_mig_strategy | default('none') }}"
        failOnInitError: {{ k8s_plugin_nvidia_device_plugin_fail_on_init_error | default(true) | bool | lower }}
        nvidiaDriverRoot: "{{ k8s_plugin_nvidia_device_plugin_driver_root | default('/') }}"
        plugin:
          passDeviceSpecs: {{ k8s_plugin_nvidia_device_plugin_pass_device_specs | default(false) | bool | lower }}
          deviceListStrategy: "{{ k8s_plugin_nvidia_device_plugin_device_list_strategy | default('envvar') }}"
          deviceIDStrategy: "{{ k8s_plugin_nvidia_device_plugin_device_id_strategy | default('uuid') }}"
